# Copy this to .env and fill in the values.
# SENDGRID_API_KEY and SENDER_EMAIL can be copied straight from
# your faq-bot .env file, they are the same account.

SENDGRID_API_KEY=your_sendgrid_key_here
SENDER_EMAIL=verified_sender@yourdomain.com

# Where restock alerts get sent. Defaults to SENDER_EMAIL if unset.
ALERT_EMAIL=patricksmediastudio@gmail.com

# How often to check, in seconds. 300 = every 5 minutes.
INTERVAL_SECONDS=300

# Where to keep seen.json. On Railway, point this at a mounted volume
# so the bot does not re-alert on old articles after every redeploy.
# STATE_DIR=/data
