# Copy this to .env and fill in the values.

# Which sender to use: "gmail" (default) or "sendgrid".
EMAIL_BACKEND=gmail

# Where restock alerts get sent.
ALERT_EMAIL=patricksmediastudio@gmail.com

# The address alerts are sent FROM. For Gmail this should be the account
# that token.json was authorised against.
SENDER_EMAIL=you@yourdomain.com

# How often to check, in seconds. 300 = every 5 minutes.
INTERVAL_SECONDS=300

# --- Gmail backend ---------------------------------------------------
# By default the bot reads token.json from this folder. Copy the one from
# faq-bot. It already has the gmail.send scope, and it carries the
# client id, client secret and refresh token, so credentials.json is not
# needed. token.json is gitignored.
#
# GMAIL_TOKEN_PATH=C:\Users\patri\Documents\faq-bot\token.json
#
# For hosting, paste the entire contents of token.json into one variable
# instead of shipping the file:
# GMAIL_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}

# --- SendGrid backend, only if EMAIL_BACKEND=sendgrid ----------------
# SENDGRID_API_KEY=your_mail_send_only_key

# Where to keep seen.json. On Railway, point this at a mounted volume
# so the bot does not re-alert on old articles after every redeploy.
# STATE_DIR=/data
