# Copy this to .env and fill in the values.

# Which sender to use: "smtp" (default), "gmail", or "sendgrid".
#
# smtp is the default on purpose. It needs a Google app password, which does
# not expire, so an unattended bot keeps working. Gmail OAuth refresh tokens
# get revoked, and expire after 7 days while the consent screen is in Testing
# mode, which kills a 24/7 watcher silently and at the worst moment.
EMAIL_BACKEND=smtp

# Where restock alerts get sent.
ALERT_EMAIL=patricksmediastudio@gmail.com

# The address alerts are sent FROM.
SENDER_EMAIL=patricksmediastudio@gmail.com

# How often to check, in seconds. 300 = every 5 minutes.
INTERVAL_SECONDS=300

# --- SMTP backend, the default --------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=patricksmediastudio@gmail.com

# A Google app password, not your account password. Create one at
# https://myaccount.google.com/apppasswords (2FA has to be on first).
# It is 16 characters. The spaces Google shows are presentational and the
# bot strips them, so pasting it either way works.
SMTP_PASSWORD=

# --- Gmail backend, only if EMAIL_BACKEND=gmail ----------------------
# Reads token.json from this folder by default. Copy the one from faq-bot:
# it already has the gmail.send scope and carries the client id, client
# secret and refresh token, so credentials.json is not needed. Gitignored.
#
# GMAIL_TOKEN_PATH=/Users/patricknarcio/Documents/faq-bot/token.json
#
# For hosting, paste the entire contents of token.json into one variable
# instead of shipping the file:
# GMAIL_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}

# --- SendGrid backend, only if EMAIL_BACKEND=sendgrid ----------------
# SENDGRID_API_KEY=your_mail_send_only_key

# Where to keep seen.json. GitHub Actions sets this to "state" so the file
# is committed back to the repo and survives between runs. On Railway, point
# it at a mounted volume instead.
# STATE_DIR=state
